<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- عنوان برنامه -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        android:textColor="#8899A6"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="40dp" />

    <!-- فیلد ورود لینک یا کانفیگ -->
    <EditText
        android:id="@+id/etConfig"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#192734"
        android:hint="@string/config_hint"
        android:textColor="#FFFFFF"
        android:textColorHint="#8899A6"
        android:textSize="14sp"
        android:padding="16dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp" />

    <!-- فیلد تنظیمات DNS -->
    <EditText
        android:id="@+id/etDns"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#192734"
        android:hint="@string/dns_hint"
        android:textColor="#FFFFFF"
        android:textColorHint="#8899A6"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:inputType="text"
        android:layout_marginBottom="32dp" />

    <!-- وضعیت اتصال -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_disconnected"
        android:textColor="#8899A6"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- دکمه اتصال / قطع اتصال -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/connect"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2D6A4F" />

</LinearLayout>
